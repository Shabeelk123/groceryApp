// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  password         String
  cartItems        String[] // stores an array of items
  resetTokenHash   String?   // sha256 hash of the active password-reset token, if any
  resetTokenExpiry DateTime? // reset link expires 1 hour after being issued
  addresses Address[]
  orders    Order[]
  reviews   Review[]
  wishlist  Wishlist[]
  @@map("users")
}

model Product {
    id         Int         @id @default(autoincrement())
    name       String
    description String
    price      Float
    offerPrice Float
    image      String[]    // Array of image URLs
    inStock    Boolean
    category   String
    model      String?     // Device model compatibility (e.g. "iPhone 17 Pro Max")
    orderItems OrderItem[] // relation to OrderItem model
    reviews    Review[]
    wishlistedBy Wishlist[]
    createdAt  DateTime    @default(now())
    updatedAt  DateTime    @updatedAt
    @@map("products")
}

model Review {
    id               Int      @id @default(autoincrement())
    userId           Int
    user             User     @relation(fields: [userId], references: [id])
    productId        Int
    product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
    rating           Int      // 1-5
    comment          String
    verifiedPurchase Boolean  @default(false)
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    @@unique([userId, productId]) // one review per user per product
    @@map("reviews")
}

model Wishlist {
    id        Int      @id @default(autoincrement())
    userId    Int
    user      User     @relation(fields: [userId], references: [id])
    productId Int
    product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())

    @@unique([userId, productId]) // a product can only be wishlisted once per user
    @@map("wishlists")
}

model Address {
    id        Int      @id @default(autoincrement())
    userId    Int
    user      User     @relation(fields: [userId], references: [id])
    firstName String
    lastName  String
    street    String
    city      String
    emirate   String   // Dubai, Abu Dhabi, Sharjah, etc. — fixed list, see EMIRATES in client
    poBox     String?  // PO Box / Makani number — UAE addresses don't use postal codes
    zipCode   Int?     // optional, kept for non-UAE addresses
    country   String   @default("United Arab Emirates")
    phone     String
    orders    Order[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Order {
    id        Int         @id @default(autoincrement())
    userId    Int
    user      User        @relation(fields: [userId], references: [id])
    items     OrderItem[] // relation to OrderItem model
    amount    Float       // total order amount
    addressId Int
    address   Address     @relation(fields: [addressId], references: [id])
    status    String      @default("Order Placed")
    paymentType String
    isPaid    Boolean
    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt
    @@map("orders")
}

model OrderItem {
    id        Int     @id @default(autoincrement())
    orderId   Int
    order     Order   @relation(fields: [orderId], references: [id])
    productId Int
    product   Product @relation(fields: [productId], references: [id])
    quantity  Int
    price     Float   // price at time of order (for historical accuracy)
    @@map("orderItems")
}


