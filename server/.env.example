# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/casehub"

# Admin / seller login (single shared admin account for now)
SELLER_EMAIL="admin@example.com"
SELLER_PASSWORD="change-me"

# Secret used to sign auth JWTs — use a long random value, required in all environments
JWT_SECRET="change-me"

NODE_ENV="development"

# Cloudinary (image hosting)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Client origin, for CORS allowlist
FRONTEND_URL="http://localhost:5173"

PORT=3000
